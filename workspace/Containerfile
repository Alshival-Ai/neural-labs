# Every stage uses the reviewed multi-platform Linux base. Provider processes
# are launched only by the native broker; there is no upstream Gateway layer.
ARG NATIVE_BASE_IMAGE=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
FROM ${NATIVE_BASE_IMAGE} AS desktop-build

USER root
WORKDIR /build

COPY workspace/desktop/package.json workspace/desktop/package-lock.json ./
RUN npm ci --include=dev

COPY workspace/desktop/index.html workspace/desktop/tsconfig.json workspace/desktop/vite.config.ts ./
COPY workspace/desktop/src ./src
COPY workspace/desktop/public ./public
COPY workspace/vendor/minipaint /vendor/minipaint
COPY workspace/build-minipaint.mjs /build-minipaint.mjs
RUN npm run build

FROM ${NATIVE_BASE_IMAGE} AS mcp-build

WORKDIR /build
COPY mcp/package.json mcp/package-lock.json ./
RUN npm ci
COPY mcp/tsconfig.json mcp/tsconfig.build.json ./
COPY mcp/src ./src
COPY mcp/test ./test
RUN npm run validate \
    && npm prune --omit=dev

FROM ${NATIVE_BASE_IMAGE}

USER root
WORKDIR /usr/local/lib/neural-labs
COPY workspace/native/release.json /usr/local/lib/neural-labs/native/release.json

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      bash-completion bubblewrap build-essential ca-certificates chromium curl poppler-utils \
      ffmpeg fonts-liberation fonts-noto-color-emoji fonts-noto-core git \
      imagemagick jq less openssh-client procps python3 python3-pip python3-venv ripgrep \
      rsync tini util-linux vim-tiny webp zsh zsh-autosuggestions zsh-syntax-highlighting \
    && rm -rf /var/lib/apt/lists/*

# Pins and architecture-specific digests come from one reviewed manifest.
# Reject unsupported architectures rather than silently running emulation.
COPY workspace/native/install-release.sh /usr/local/lib/neural-labs/native/install-release.sh
RUN bash /usr/local/lib/neural-labs/native/install-release.sh

COPY workspace/package.json workspace/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm rebuild node-pty \
    && npm cache clean --force

# Copy the native entrypoint's reviewed module graph only. Historical migration
# readers are included; old provider plugins and Gateway modules are not.
COPY workspace/start.mjs workspace/http-server.mjs workspace/response-work.mjs \
     workspace/builder-manager.mjs workspace/vscode-proxy.mjs \
     workspace/file-manager.mjs workspace/explorer-manager.mjs \
     workspace/skills-manager.mjs workspace/package-files.mjs workspace/file-events.mjs \
     workspace/voice.mjs workspace/terminal-agent.mjs workspace/terminal-manager.mjs \
     workspace/public-apps.mjs workspace/imported-history.mjs workspace/import-history.mjs ./
COPY workspace/native ./native
COPY workspace/bundled-skills/deploy /usr/local/share/neural-labs/skills/deploy
COPY workspace/bundled-skills/site-generator /usr/local/share/neural-labs/skills/site-generator
COPY workspace/bundled-skills/local-business-website-builder /usr/local/share/neural-labs/skills/local-business-website-builder
COPY workspace/bundled-skills/business-research-and-media /usr/local/share/neural-labs/skills/business-research-and-media
COPY workspace/bundled-skills/cinematic-interactions /usr/local/share/neural-labs/skills/cinematic-interactions
COPY workspace/bundled-skills/web-video-asset-preparation /usr/local/share/neural-labs/skills/web-video-asset-preparation
COPY --chmod=0755 workspace/entrypoint.sh /usr/local/bin/neural-labs-runtime
COPY --from=desktop-build /build/dist /usr/local/share/neural-labs/desktop
COPY --chown=node:node --from=mcp-build /build/package.json /build/package-lock.json /usr/local/lib/neural-labs/mcp/
COPY --chown=node:node --from=mcp-build /build/node_modules /usr/local/lib/neural-labs/mcp/node_modules
COPY --chown=node:node --from=mcp-build /build/dist /usr/local/lib/neural-labs/mcp/dist

RUN mkdir -p /home/node/workspace/projects /home/node/.local/state/neural-labs /run/neural-labs \
    && chown -R node:node /home/node /run/neural-labs \
    && chmod 0700 /run/neural-labs \
    && test ! -e /app \
    && ! command -v openclaw \
    && node -e 'const p=require("./package-lock.json");if(Object.keys(p.packages).some(k=>k.includes("@openclaw/")))process.exit(1)'

ENV HOME=/home/node \
    NEURAL_LABS_RUNTIME_VERSION=1.0.0 \
    NEURAL_LABS_CODEX_VERSION=0.155.1 \
    NEURAL_LABS_CLAUDE_VERSION=2.1.226 \
    DISABLE_AUTOUPDATER=1 \
    NEURAL_LABS_WORKSPACE_ROOT=/home/node/workspace \
    NEURAL_LABS_NATIVE_STATE_ROOT=/home/node/.local/state/neural-labs/native

USER node
WORKDIR /home/node/workspace
EXPOSE 18790
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=10 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:18790/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/neural-labs-runtime"]
