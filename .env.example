# Neural Labs single-file deployment configuration.
# Copy to .env, keep mode 0600, and never commit the real file.

# Public deployment settings
NEURAL_LABS_PUBLIC_ORIGIN=https://neural-labs.example.com
NEURAL_LABS_HOSTNAME=neural-labs.example.com
NEURAL_LABS_BIND_ADDRESS=127.0.0.1
LANDING_PORT=4173
CONTROL_PLANE_PORT=4174
WORKSPACE_PORT=4180
WORKSPACE_DESKTOP_PORT=4181

# One shared, continuously running developer workspace. Keep the OpenClaw base
# image pinned by digest and update it only as an explicit release operation.
NEURAL_LABS_WORKSPACE_IMAGE=neural-labs-workspace:local
NEURAL_LABS_OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2@sha256:5d25165995041caa6a7175bec82b25ad98c44eb269bb42435da8e27ec06e6be4
NEURAL_LABS_OPENCLAW_VERSION=2026.8.2
NEURAL_LABS_CODEX_VERSION=0.152.0
NEURAL_LABS_WORKSPACE_CPUS=10
NEURAL_LABS_WORKSPACE_MEMORY=16g
NEURAL_LABS_WORKSPACE_MAX_UPLOAD_BYTES=2147483648
NEURAL_LABS_WORKSPACE_SUBNET=172.30.42.0/29
NEURAL_LABS_WORKSPACE_PROXY_IP=172.30.42.1

# WebRTC voice relay. The public router/firewall must forward TURN_PORT over
# TCP+UDP and the full UDP relay range to TURN_RELAY_IP.
NEURAL_LABS_TURN_IMAGE=coturn/coturn:4.17.2-r0@sha256:aa68aab64a3b929d57fc2924c98ea447bf996cf8dade2508e7b71eaf23f1f14e
NEURAL_LABS_TURN_HOST=neural-labs.example.com
NEURAL_LABS_TURN_EXTERNAL_IP=203.0.113.10
NEURAL_LABS_TURN_RELAY_IP=192.0.2.10
NEURAL_LABS_TURN_PORT=3478
NEURAL_LABS_TURN_MIN_PORT=49160
NEURAL_LABS_TURN_MAX_PORT=49200
NEURAL_LABS_TURN_URLS=stun:neural-labs.example.com:3478,turn:neural-labs.example.com:3478?transport=udp,turn:neural-labs.example.com:3478?transport=tcp

# Provider credentials injected only into the trusted workspace-local MCP.
# Keep real values only in the ignored, mode-0600 root .env.
GOOGLE_PLACES_API_KEY=
KLIPY_API_KEY=
PEXELS_API_KEY=

# Initial provider switches read by first-run setup
NEURAL_LABS_AUTO_SETUP=true
NEURAL_LABS_INITIAL_ADMIN_EMAIL=admin@example.com
NEURAL_LABS_LOCAL_AUTH_ENABLED=true
NEURAL_LABS_MICROSOFT_AUTH_ENABLED=false
NEURAL_LABS_MCP_ENABLED=false

# Generated automatically by `bin/neural-labs init`.
NEURAL_LABS_POSTGRES_PASSWORD=replace-with-a-random-postgres-password
NEURAL_LABS_CONTROL_PLANE_MASTER_KEY=replace-with-32-random-bytes-as-base64
NEURAL_LABS_MCP_CONFIG_TOKEN=replace-with-a-random-internal-token
NEURAL_LABS_WORKSPACE_CONTROL_TOKEN=replace-with-a-separate-random-workspace-control-token
NEURAL_LABS_TURN_SECRET=replace-with-a-separate-random-turn-auth-secret

# Optional Microsoft Entra configuration. Leave all credential fields blank
# when Microsoft login and MCP authentication are not being configured.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# Choose either a client secret or a base64-encoded PEM bundle containing the
# certificate and matching private key. Do not populate both.
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_BASE64=
AZURE_CLIENT_CERTIFICATE_PASSPHRASE=
