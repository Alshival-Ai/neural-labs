# Public tenant metadata. Copy outside Git as tenant.env.
TENANT_ID=example-dev
TZ=America/Chicago

# Host-managed paths; none may point into /home/data-team or another tenant.
TENANT_HOME_DIR=/srv/neural-labs/tenants/example-dev/home
TENANT_SECRETS_ENV=/srv/neural-labs/tenants/example-dev/secrets/gateway.env
GLOBAL_SKILLS_DIR=/opt/neural-labs/current/skills

# Build and pin these before production promotion. Never use :latest.
GATEWAY_IMAGE=neural-labs/openclaw-gateway:dev

# Compose enforces loopback-only web ingress during Step 1.
GATEWAY_PORT=18791

# Per-cell ceilings.
GATEWAY_CPUS=2.0
GATEWAY_MEMORY=3g
GATEWAY_PIDS_LIMIT=512
