FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build

WORKDIR /build
COPY control-plane/package.json control-plane/package-lock.json ./
RUN npm ci
COPY control-plane/tsconfig.json control-plane/tsconfig.build.json ./
COPY control-plane/src/ ./src/
RUN npm run build

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS console-build

WORKDIR /console
COPY console/package.json console/package-lock.json ./
RUN npm ci
COPY console/index.html console/tsconfig.json console/vite.config.ts ./
COPY console/src/ ./src/
RUN npm run build

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS runtime

ENV NODE_ENV=production
WORKDIR /app
COPY --chown=node:node control-plane/package.json control-plane/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node --from=build /build/dist/ ./dist/
COPY --chown=node:node control-plane/public/ ./public/
COPY --chown=node:node --from=console-build /console/dist/ ./public/console/

USER node
EXPOSE 4174
CMD ["node", "dist/index.js"]
