    {
      "name": "project_create",
      "description": "Create a task, deliverable, note, resource, comment or permitted board. Comments use parent_id; reuse the request UUID on retry.",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "description": "Select an authorized workspace for a multi-workspace connection; omit for an instance-local connection."
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "task",
              "deliverable",
              "note",
              "resource",
              "comment",
              "board"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "body": {
                "type": "string",
                "maxLength": 3000
              },
              "acceptance": {
                "type": "string",
                "maxLength": 4000
              },
              "state": {
                "enum": [
                  "todo",
                  "doing",
                  "waiting",
                  "review",
                  "done"
                ]
              },
              "priority": {
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              },
              "visibility": {
                "enum": [
                  "shared",
                  "internal"
                ]
              },
              "assignee": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "starts_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "due_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "board_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "color": {
                "enum": [
                  "yellow",
                  "blue",
                  "pink",
                  "green",
                  "orange",
                  "purple",
                  "teal",
                  "gray"
                ]
              },
              "archived": {
                "type": "boolean"
              },
              "deleted": {
                "type": "boolean"
              },
              "checklist": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "done": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "done"
                  ],
                  "additionalProperties": false
                }
              },
              "resource": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "website",
                      "server",
                      "database",
                      "api",
                      "repository",
                      "domain",
                      "storage",
                      "other"
                    ]
                  },
                  "status": {
                    "enum": [
                      "planned",
                      "active",
                      "retired"
                    ]
                  },
                  "provider": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "environment": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "public_url": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "external_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 200
                  },
                  "sticker": {
                    "enum": [
                      "auto",
                      "website",
                      "server",
                      "database",
                      "api",
                      "repository",
                      "domain",
                      "storage",
                      "other"
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "required": [
          "idempotency_key",
          "kind",
          "data"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "task",
              "note",
              "resource",
              "deliverable",
              "comment",
              "board"
