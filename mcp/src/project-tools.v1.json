    {
      "name": "project_list",
      "description": "List visible board records, ordered by opaque ID. Follow next until null.",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "description": "Select an authorized workspace for a multi-workspace connection; omit for an instance-local connection."
          },
          "after": {
            "type": "string",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "task",
              "deliverable",
              "note",
              "resource",
              "comment",
              "board"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "task",
                    "note",
                    "resource",
                    "deliverable",
                    "comment",
                    "board"
                  ]
                },
                "revision": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "data": {
                  "type": "object"
                },
                "created_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "updated_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "revision",
                "data"
              ],
              "additionalProperties": false
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next"
        ],
        "additionalProperties": false
      }
    },
