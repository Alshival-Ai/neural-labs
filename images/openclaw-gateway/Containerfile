ARG OPENCLAW_BASE_IMAGE
FROM ${OPENCLAW_BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      less \
      openssh-client \
      procps \
      python3 \
      python3-venv \
      ripgrep \
      rsync \
      sudo \
      unzip \
      vim-tiny \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' 'node ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-openclaw-node \
    && chmod 0440 /etc/sudoers.d/90-openclaw-node

USER node
